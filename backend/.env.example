# Bu dosyayı .env olarak kopyalayın ve değerleri ortama göre düzenleyin.
# .env dosyası sürüm kontrolüne dahil edilmez (bkz. .gitignore).

# Veritabanı. Varsayılanlar docker-compose.yml ile uyumludur.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=muteahhit_db

# Token imzalama anahtarı. Üretimde mutlaka değiştirin.
JWT_SECRET=degistir-bu-cok-gizli-bir-anahtar-olmali
JWT_EXPIRES_IN=7d

# Sistem uçlarının (/system/*) X-API-Key doğrulaması. Kullanıcı oturumu gerektirmeyen,
# zamanlanmış iş tetikleme gibi çağrılar için kullanılır. Üretimde mutlaka değiştirin.
SYSTEM_API_KEY=degistir-bu-da-uzun-rastgele-bir-anahtar-olmali

PORT=3000

# Yüklenen dosyaların saklanacağı klasör (uygulama kök dizinine göre).
UPLOAD_DIR=uploads

# Yüklenen dosyaların erişim adresi. Mobil istemci bu adresle görsele ulaşır, bu yüzden
# localhost değil, cihazın erişebildiği adres olmalı (örn. http://192.168.1.34:3000).
PUBLIC_BASE_URL=http://localhost:3000
