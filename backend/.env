# Bu dosyayı kopyalayıp .env adıyla kaydet, gerçek değerleri gir.
# .env dosyası asla git'e eklenmemeli (bkz. .gitignore).

# Veritabanı (docker-compose ile ayağa kaldıracağımız Postgres bilgileri)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=muteahhit_db

# JWT (giriş/kayıt token'ı için gizli anahtar -- production'da mutlaka değiştir)
JWT_SECRET=degistir-bu-cok-gizli-bir-anahtar-olmali
JWT_EXPIRES_IN=7d

# Sistem API Anahtarı (n8n gibi dış otomasyon araçlarının, bir kullanıcı hesabı olmadan
# sistem geneli işlemleri -- örn. günlük faiz işletme -- tetikleyebilmesi için).
# Production'da mutlaka uzun, rastgele bir değerle değiştir (örn. bir şifre üreteciyle).
SYSTEM_API_KEY=degistir-bu-da-uzun-rastgele-bir-anahtar-olmali

# Uygulama
PORT=3000
